# ═══════════════════════════════════════════════════════════════════════
# MandiIQ — Streamlit Cloud Secrets Template
# ═══════════════════════════════════════════════════════════════════════
#
# For local development:
#   1. Copy this to .streamlit/secrets.toml
#   2. Fill in your API keys
#   3. Ensure .streamlit/secrets.toml is in .gitignore (it is)
#
# For production (Streamlit Cloud):
#   Paste the filled-in contents at:
#   https://share.streamlit.io → MandiIQ → Settings → Secrets
#
# Streamlit Cloud merges these into os.environ so the dashboard pages
# read them via os.environ.get() AND st.secrets.get() interchangeably.
# ═══════════════════════════════════════════════════════════════════════


# ── 1. API Endpoint ─────────────────────────────────────────────────
# URL of the deployed FastAPI backend the dashboard calls for data.
#   Local dev:   http://localhost:8000
#   Northflank:  https://your-service.northflank.app
#   Render:      https://mandiiq-api.onrender.com
# Falls back to MANDIIQ_API_URL if this is unset.
MANDIQ_API_URL = "http://localhost:8000"


# ── 2. Data Sources ──────────────────────────────────────────────────
# These are read by the dashboard pages directly via st.secrets.get().
# Falls back to DATA_GOV_IN_API_KEY from os.environ.

# Rainfall-specific API key (same account as DATA_GOV_IN_API_KEY).
# Read by: pages/discontinuity.py, pages/executive_overview.py
ALL_INDIA_RAINFALL_API_KEY = ""
ALL_INDIA_RAINFALL_RESOURCE_ID = ""


# ── 3. AI / LLM Providers ───────────────────────────────────────────
# All three are optional.  Without them the "Ask MandiIQ" panel shows
# "AI module not available" — core dashboard features still work.

# Google Gemini API key — https://aistudio.google.com/
GEMINI_API_KEY = ""

# OpenRouter API key (free tier, no credit card) — https://openrouter.ai/keys
OPENROUTER_API_KEY = ""

# NVIDIA NIM API key (DeepSeek V4 Pro) — https://build.nvidia.com/
NVIDIA_API_KEY = ""


# ── 4. Data.gov.in (Primary) ────────────────────────────────────────
# Required for live price ingestion.  The demo key is rate-limited.
# Register at https://api.data.gov.in/manage → My Account → API Keys
# Falls back to DATA_GOV_API_KEY (older alias) if this is unset.
DATA_GOV_IN_API_KEY = "YOUR_API_KEY_HERE"


# ── 5. Database Path (optional override) ────────────────────────────
# Defaults to mandi_rdd/data/mandi_iq.duckdb (relative to repo root).
# Usually not needed on Streamlit Cloud since the DB is bundled.
# MANDIIQ_DB_PATH = ""
