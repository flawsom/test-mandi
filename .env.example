# ═══════════════════════════════════════════════════════════════════════
# MandiIQ — Environment Variables Master Reference
# ═══════════════════════════════════════════════════════════════════════
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For production, set these as:
#   - Northflank / Render: Dashboard → Environment tab
#   - Vercel:              vercel env add VAR_NAME
#   - Streamlit Cloud:     Dashboard → Settings → Secrets (TOML format)
#   - GitHub Actions:      repo → Settings → Secrets and Variables → Actions
#   - Docker:              -e VAR_NAME=value or env_file in docker-compose.yml
#
# ── Groups ───────────────────────────────────────────────────────────
#   1. REQUIRED       — pipeline fails without these
#   2. DATA SOURCES   — API keys for external data providers
#   3. AI / LLM       — model provider keys (dashboard AI features)
#   4. SERVER CONFIG  — runtime behaviour of FastAPI / Streamlit
#   5. BACKUP (R2)    — Cloudflare R2 object-storage backup
#   6. OBSERVABILITY  — Prometheus / Grafana Cloud metrics push
#   7. CI/CD SECRETS  — deploy-trigger tokens (GitHub secrets, not .env)
# ═══════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════════
# 1 ║ REQUIRED — pipeline fails loudly without these
# ═══════════════════════════════════════════════════════════════════════

# Primary API key for data.gov.in.  Used by:
#   - mandi_rdd/ingestion/fetch_prices.py        → daily price ingest
#   - mandi_rdd/ingestion/fetch_historical.py    → historical CSV import
#   - mandi_rdd/ingestion/fetch_rainfall.py      → IMD rainfall (fallback)
#   - mandi_rdd/ingestion/http_client.py         → generic API client
#   - mandi_rdd/ingestion/fetch_historical_ashoka.py
#
# Register at https://api.data.gov.in/manage → My Account → API Keys
# The public demo key is rate-limited (~100 req/day).
# A registered key is unlimited and required for production nightly runs.
#
# Alias: DATA_GOV_API_KEY (checked as fallback if this is unset)
DATA_GOV_IN_API_KEY=YOUR_API_KEY_HERE


# ═══════════════════════════════════════════════════════════════════════
# 2 ║ DATA SOURCES — external APIs for mandi prices, rainfall, NDVI
# ═══════════════════════════════════════════════════════════════════════

# ── All-India Rainfall (data.gov.in) ─────────────────────────────────

# Rainfall-specific API key.  If unset, falls back to DATA_GOV_IN_API_KEY.
# Consumed by:
#   - mandi_rdd/ingestion/fetch_rainfall.py  (line 66, 78)
#   - mandi_rdd/dashboard/pages/discontinuity.py
#   - mandi_rdd/dashboard/pages/executive_overview.py
#
# Register at the same data.gov.in account as above.
ALL_INDIA_RAINFALL_API_KEY=

# Resource ID for the IMD sub-division rainfall dataset.
# Default: empty string → code uses a hardcoded fallback resource ID.
# Override if data.gov.in changes the catalog URL.
#
# Alias: RAINFALL_RESOURCE_ID
ALL_INDIA_RAINFALL_RESOURCE_ID=

# ── Sentinel Hub NDVI (satellite vegetation index) ───────────────────

# OAuth2 client credentials for Sentinel Hub.
# Required for NDVI data fetching.  Optional — pipeline skips NDVI if
# either is missing.
#
# Register at https://www.sentinel-hub.com/ → Dashboard → OAuth clients
#   Client name: MandiIQ
#   Grant type:  Client Credentials
#
# Consumed by:
#   - mandi_rdd/ingestion/fetch_ndvi.py    (OAuth token + stats API calls)
#   - mandi_rdd/ingestion/scheduler.py     (step-gating: skip NDVI when missing)
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=


# ═══════════════════════════════════════════════════════════════════════
# 3 ║ AI / LLM — model providers for "Ask MandiIQ" + nightly narrative
# ═══════════════════════════════════════════════════════════════════════
#
# All three are optional.  Without them the dashboard still works — the
# "Ask MandiIQ" panel shows "AI module not available" and the nightly
# narrative is skipped.

# Google Gemini API key for LLM fallback.
# Get one at https://aistudio.google.com/ → Get API Key
# Consumed by mandi_rdd/ai/router.py and dashboard Ask/Settings pages.
GEMINI_API_KEY=

# OpenRouter API key (free-tier, no credit card required).
# Routes across free models with circuit-breaker fallback.
# Get one at https://openrouter.ai/keys
# Consumed by mandi_rdd/ai/router.py and dashboard pages.
OPENROUTER_API_KEY=

# NVIDIA NIM API key (DeepSeek V4 Pro and other hosted models).
# Get one at https://build.nvidia.com/ → API → Generate Key
# Consumed by mandi_rdd/ai/router.py (primary model route).
NVIDIA_API_KEY=


# ═══════════════════════════════════════════════════════════════════════
# 4 ║ SERVER CONFIG — FastAPI and Streamlit runtime behaviour
# ═══════════════════════════════════════════════════════════════════════

# URL of the deployed FastAPI backend.
# The Streamlit dashboard reads this to make API calls.
#   Local dev:   http://localhost:8000
#   Northflank:  https://your-service.northflank.app
#   Northflank:  https://p01--mandiiq--zbvjrztgjqgw.code.run
#
# Consumed by:
#   - mandi_rdd/dashboard/data_access.py  (line 13 — two alias fallback)
#   - mandi_rdd/dashboard/theme.py        (monitoring alerts)
#   - mandi_rdd/scripts/check_freshness.py
#
# Aliases (checked in order): MANDIQ_API_URL → MANDIIQ_API_URL
MANDIQ_API_URL=http://localhost:8000

# Port for the FastAPI server.
# Default: 8000.  Set automatically by Northflank/Render/Vercel.
# Consumed by mandi_rdd/api/main.py (uvicorn startup).
PORT=8000

# Path to the DuckDB database file.
# Default: mandi_rdd/data/mandi_iq.duckdb (relative to repo root)
# On Northflank: /data/mandi_iq.duckdb (persistent volume mount)
# On Render:     mandi_rdd/data/mandi_iq.duckdb (bundled in deploy)
#
# Consumed by:
#   - mandi_rdd/storage/duckdb_store.py     (line 51 — DB connection)
#   - mandi_rdd/ingestion/ingest_kaggle.py  (alternative CSV import)
#   - api/index.py                          (Vercel entrypoint override)
MANDIIQ_DB_PATH=mandi_rdd/data/mandi_iq.duckdb

# Secret key for session signing / CSRF protection.
# Generate a random string:  python -c "import secrets; print(secrets.token_hex(32))"
# Used by FastAPI session middleware.

# Webhook secret for Grafana dashboard synchronization.
# Must match the secret set in your Grafana webhook configuration.
# Consumed by mandi_rdd/api/main.py (line 1472 — webhook auth).
WEBHOOK_SECRET=


# ═══════════════════════════════════════════════════════════════════════
# 5 ║ BACKUP (Cloudflare R2) — DuckDB offsite backup
# ═══════════════════════════════════════════════════════════════════════
#
# All four are optional.  Without them the nightly pipeline uploads the
# DuckDB to git (with a warning) instead of R2.
#
# Create an R2 bucket at https://dash.cloudflare.com/ → R2 → Create Bucket
# Then generate an API token with Object Read & Write permissions.
#
# Consumed by:
#   - mandi_rdd/api/main.py  (lines 1028-1031, 1283-1286 — backup endpoints)
#   - nightly-ingest.yml, mandi_rdd_ci.yml  (GitHub Actions upload steps)

# R2 bucket name.  Alias: R2_BUCKET_NAME
R2_BUCKET=mandiiq-data

# Cloudflare account ID (find it in the R2 dashboard URL:
# https://dash.cloudflare.com/?to=/:account-id/r2/overview)
R2_ACCOUNT_ID=

# R2 S3-compatible access key and secret.
# Generate at: R2 Dashboard → Manage R2 API Tokens → Create API Token
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=


# ═══════════════════════════════════════════════════════════════════════
# 6 ║ OBSERVABILITY — Prometheus / Grafana Cloud metrics push
# ═══════════════════════════════════════════════════════════════════════
#
# All three are optional.  Without them the /metrics endpoint works but
# metrics are not pushed to Grafana Cloud.
#
# Get these from your Grafana Cloud stack:
#   https://grafana.com/ → My Account → Details → Prometheus
#
# Consumed by mandi_rdd/api/metrics_push.py (lines 37-46).

# Prometheus remote-write URL (e.g. https://prometheus-prod-XX-prod-XX.grafana.net)
GRAFANA_CLOUD_PROM_URL=

# HTTP Basic Auth username (usually a numeric stack ID).
GRAFANA_CLOUD_PROM_USER=

# HTTP Basic Auth password (Grafana Cloud API token with metrics:write scope).
# Alias: GRAFANA_CLOUD_PROM_PASSWORD
GRAFANA_CLOUD_PROM_PASS=


# ═══════════════════════════════════════════════════════════════════════
# 7 ║ CI/CD SECRETS — deploy tokens (set as GitHub secrets, not .env)
# ═══════════════════════════════════════════════════════════════════════
#
# These are NOT read at runtime — they are used by GitHub Actions workflows
# to trigger external deployments.  Set them at:
#   https://github.com/flawsom/test-mandi/settings/secrets/actions
#
# RENDER_DEPLOY_HOOK_URL
#   From: Render Dashboard → mandiiq-api → Settings → Deploy Hooks → Create
#   Used by: .github/workflows/deploy-render.yml
#
# VERCEL_TOKEN
#   From: https://vercel.com/account/tokens → Create
#   Used by: .github/workflows/deploy-vercel.yml
#
# GITHUB_TOKEN / GH_TOKEN
#   Set automatically by GitHub Actions (GITHUB_TOKEN) or personal token
#   for admin operations.  Used by mandi_rdd/api/main.py (line 2297).
# ═══════════════════════════════════════════════════════════════════════
