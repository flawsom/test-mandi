{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "gh-pages": false
    }
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": "{**/data/mandi_iq.duckdb,**/data/mandi_iq.duckdb.*,**/repomix*,**/tests/**,**/__pycache__/**,**/node_modules/**,**/.git/**,archive/**,docs/**,landing/**,scripts/**,**/screenshots/**,mandi_rdd/dashboard/**,test_output/**}"
    }
  },
  "installCommand": "cp requirements-vercel.txt requirements.txt && python -m pip install -r requirements.txt",
  "buildCommand": "cp requirements-vercel.txt requirements.txt"
}
