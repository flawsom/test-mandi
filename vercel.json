{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "gh-pages": false
    }
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": "{tests/**,**/tests/**,test_output/**,**/test_output/**,**/screenshots/**,**/data/mandi_iq.duckdb.pre_fix_backup,**/data/mandi_iq.duckdb.backup,**/data/*.backup,**/repomix*,archive/**,**/archive/**,demo/**,**/demo/**,worker/**,**/worker/**,landing/**,**/landing/**,docs/**,**/docs/**,**/node_modules/**,**/__pycache__/**,**/.pytest_cache/**,**.git/**,**/.git/**,**.vercel/**,**.streamlit/**,scripts/**,**/scripts/**,mandi_rdd/dashboard/**,mandi_rdd/styles/**}"
    }
  },
  "buildCommand": "cp requirements-vercel.txt requirements.txt"
}
